# MyEnglish Environment Configuration
# Copy this file to .env and fill in your own values
# Never commit .env file - it's in .gitignore for security

# ============================================
# Google Cloud Translation API Configuration
# ============================================
# REQUIRED: Path to Google Cloud credentials JSON file
# Download from: https://console.cloud.google.com/
# App will fail if not set (validation in config.py)
GOOGLE_CREDENTIALS_PATH=gg_cloud_key.json

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file
# Default: app_data.db (created automatically in project root)
# DB_PATH=app_data.db

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# ============================================
# Application Settings
# ============================================
# Debug mode: True or False
# Default: False
# DEBUG=False

# ============================================
# Notes
# ============================================
# - If GOOGLE_CREDENTIALS_PATH not found, app will fallback to googletrans (free)
# - All values should be simple strings (no quotes needed)
# - Lines starting with # are comments
# - Uncomment lines by removing # prefix if you need to customize defaults
